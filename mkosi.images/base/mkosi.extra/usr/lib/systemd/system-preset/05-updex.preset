# SPDX-License-Identifier: LGPL-2.1-or-later
# Automatic sysext updates: frostyard-updex stages, verifies and links a
# revision; it takes effect at the next boot, never by an immediate reboot.
# Opt out on a host with `systemctl mask updex-update.timer`.
# See updex ADR-0016.
enable updex-update.timer
# After a `bootc switch` between Debian suites, link the running suite's
# sysext images at boot, before updex-update.service runs.
# See updex ADR-0021.
enable updex-suite-switch.service
