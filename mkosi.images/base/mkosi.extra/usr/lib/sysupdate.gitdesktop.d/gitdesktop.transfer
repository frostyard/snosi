[Transfer]
Features=gitdesktop
Verify=true

[Source]
Type=url-file
Path=https://repository.frostyard.org/ext/gitdesktop/
MatchPattern=gitdesktop_@v_%w_%a.raw.zst \
             gitdesktop_@v_%w_%a.raw.xz \
             gitdesktop_@v_%w_%a.raw.gz \
             gitdesktop_@v_%w_%a.raw

[Target]
Type=regular-file
Path=/var/lib/extensions.d/
MatchPattern=gitdesktop_@v_%w_%a.raw.zst \
             gitdesktop_@v_%w_%a.raw.xz \
             gitdesktop_@v_%w_%a.raw.gz \
             gitdesktop_@v_%w_%a.raw
CurrentSymlink=gitdesktop.raw
