[Transfer]
Features=maild
Verify=true

[Source]
Type=url-file
Path=https://repository.frostyard.org/ext/maild/
MatchPattern=maild_@v_%w_%a.raw.zst \
             maild_@v_%w_%a.raw.xz \
             maild_@v_%w_%a.raw.gz \
             maild_@v_%w_%a.raw

[Target]
Type=regular-file
Path=/var/lib/extensions.d/
MatchPattern=maild_@v_%w_%a.raw.zst \
             maild_@v_%w_%a.raw.xz \
             maild_@v_%w_%a.raw.gz \
             maild_@v_%w_%a.raw
CurrentSymlink=maild.raw
