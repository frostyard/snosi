[Transfer]
Features=paseo
Verify=false

[Source]
Type=url-file
Path=https://repository.frostyard.org/ext/paseo/
MatchPattern=paseo_@v_%w_%a.raw.zst \
             paseo_@v_%w_%a.raw.xz \
             paseo_@v_%w_%a.raw.gz \
             paseo_@v_%w_%a.raw

[Target]
Type=regular-file
Path=/var/lib/extensions.d/
MatchPattern=paseo_@v_%w_%a.raw.zst \
             paseo_@v_%w_%a.raw.xz \
             paseo_@v_%w_%a.raw.gz \
             paseo_@v_%w_%a.raw
CurrentSymlink=paseo.raw
