[Transfer]
Features=porterd
Verify=true

[Source]
Type=url-file
Path=https://repository.frostyard.org/ext/porterd/
MatchPattern=porterd_@v_%w_%a.raw.zst \
             porterd_@v_%w_%a.raw.xz \
             porterd_@v_%w_%a.raw.gz \
             porterd_@v_%w_%a.raw

[Target]
Type=regular-file
Path=/var/lib/extensions.d/
MatchPattern=porterd_@v_%w_%a.raw.zst \
             porterd_@v_%w_%a.raw.xz \
             porterd_@v_%w_%a.raw.gz \
             porterd_@v_%w_%a.raw
CurrentSymlink=porterd.raw
