#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Stage a bootc update: pull the followed image via podman, then stage it
# with `bootc switch --transport containers-storage`. The staged deployment
# applies at the next natural reboot (bootc-finalize-staged.service), which
# mirrors nbc's download-only semantics — no forced reboot.
#
# podman does the transfer because bootc's registry-transport composefs pull
# currently fails on snosi images (known upstream bug; see the findings log
# in docs/plans/2026-07-03-bootc-update-validation-plan.md). podman enforces
# the strict update policy below at pull time: that policy lives in immutable
# /usr, so it is not the system policy (/etc/containers/policy.json) and root
# dotfiles or /etc drift cannot weaken it (ADR-0025).
set -euo pipefail

# The strict signature policy this stager enforces on its own pull. A literal
# path with no environment override: the file is in immutable /usr, so a root
# ~/.config/containers/policy.json or a 3-way-merged /etc edit cannot replace
# it (ADR-0025).
readonly BOOTC_POLICY=/usr/lib/snosi/containers/bootc-policy.json

# Check-result state: written on EVERY run (not only when staging) so that
# "current", "update staged", and "checker broken" are distinguishable
# without reading the journal. Consumed by the motd hook
# (/etc/update-motd.d/86-bootc-update-staged) and snosi-update-status.
# Lives in /run: stale results do not survive a reboot.
RUN_DIR=${SNOSI_RUN_DIR:-/run/snosi}
CHECK="$RUN_DIR/update-check"

# Serialize stager runs. The staged deployment is shared state: this run checks
# a locked digest and then unlocks it with `bootc upgrade --from-downloaded`,
# which unlocks WHATEVER is staged at that moment. A second run could stage a
# different locked deployment in between, so two runs must never overlap. The
# lock is held by this process on the fd below and released when it exits.
# It serializes stager runs only: an operator who runs `bootc switch` or
# `bootc upgrade` by hand at the same moment is a trusted root action.
mkdir -p "$RUN_DIR"
exec {lock_fd}>"$RUN_DIR/update-stage.lock"
if ! flock -n "$lock_fd"; then
    echo "Another bootc-update-stage run holds $RUN_DIR/update-stage.lock; not running concurrently."
    # Write no check result: the run that holds the lock writes it.
    exit 0
fi

# Shared staged-package sidecar publisher (ADR-0014). Sourced here (publish
# side) and by snosi-update-status (resolve side). SNOSI_RUN_DIR, honored
# above, is also honored by the library for the sidecar location.
STAGED_PACKAGES_LIB="${SNOSI_STAGED_PACKAGES_LIB:-/usr/lib/snosi/staged-packages.sh}"
# shellcheck source=/dev/null
[[ -r $STAGED_PACKAGES_LIB ]] && source "$STAGED_PACKAGES_LIB"

# capture_pulled_packages IMAGE -- copy the pulled image's frozen package list
# (/usr/share/frostyard/<IMAGE_ID>.packages.txt, core ADR-0003) to a private
# temp file and print its path. MUST run before `bootc switch`/`upgrade`: once
# a deployment is staged, a copy failure can no longer unstage it, so this
# capture is a hard prerequisite of staging, not a post-step (ADR-0014).
# Copies the whole frostyard dir and globs the single *.packages.txt rather
# than parsing the image's os-release ID -- more robust, and correct even if a
# product were renamed between versions (the diff is over bytes, not names).
capture_pulled_packages() { # image
    local image=$1 cid extract tmp
    extract="$(mktemp -d)" || return 1
    # --pull=never: the image is already in local storage from the verified
    # pull; never let this step pull again under the relaxed system policy.
    if ! cid="$(podman create --quiet --pull=never "$image")"; then
        rm -rf "$extract"
        return 1
    fi
    if ! podman cp "$cid:/usr/share/frostyard/." "$extract" 2>/dev/null; then
        podman rm -f "$cid" >/dev/null 2>&1 || true
        rm -rf "$extract"
        return 1
    fi
    podman rm -f "$cid" >/dev/null 2>&1 || true

    shopt -s nullglob
    local matches=("$extract"/*.packages.txt)
    shopt -u nullglob
    if [[ ${#matches[@]} -ne 1 ]]; then
        echo "ERROR: expected exactly one *.packages.txt in the pulled image, found ${#matches[@]}" >&2
        rm -rf "$extract"
        return 1
    fi
    tmp="$(mktemp)" || { rm -rf "$extract"; return 1; }
    cp -- "${matches[0]}" "$tmp" || { rm -rf "$extract" "$tmp"; return 1; }
    rm -rf "$extract"
    printf '%s\n' "$tmp"
}

# publish_pkg_sidecar DIGEST SRC -- best-effort sidecar publish. A publish
# failure never fails the stage (the deployment is already staged by the time
# this is called; the next timer run's pulled==staged branch repairs it).
publish_pkg_sidecar() { # digest src
    local digest=$1 src=$2
    [[ -n $src && -r $src ]] || return 0
    command -v staged_packages_publish >/dev/null 2>&1 || return 0
    staged_packages_publish digest "$digest" "$src" \
        || echo "WARNING: could not publish the staged-package sidecar for $digest" >&2
}

running_version=""
if [[ -r /usr/lib/os-release ]]; then
    running_version=$(. /usr/lib/os-release && echo "${IMAGE_VERSION:-}")
fi

write_check() { # outcome
    mkdir -p "$RUN_DIR"
    printf 'outcome=%s\nchecked_at=%s\nimage=%s\nrunning_version=%s\nremote_version=%s\n' \
        "$1" "$(date --iso-8601=seconds)" "${image:-}" "$running_version" \
        "${remote_version:-}" >"$CHECK"
}

# A real staged semaphore may coexist with outcome=failed when a later check fails.
# Any failure (podman pull, bootc, the post-stage digest verify) records
# outcome=failed; a broken checker must not be indistinguishable from an
# up-to-date system. The trap also removes the private packages.txt temp file
# (ADR-0014 capture-before-stage) on every exit path.
pkg_temp=""
trap '[[ $? -eq 0 ]] || write_check failed; [[ -n $pkg_temp ]] && rm -f "$pkg_temp"' EXIT

status=$(bootc status --format json)

image=$(jq -r '.spec.image.image // empty' <<<"$status")
if [[ -z "$image" ]]; then
    # Not a bootc-managed system (e.g. an nbc A/B install): nothing to do.
    echo "No bootc image spec; not a bootc-managed system. Nothing to do."
    exit 0
fi
transport=$(jq -r '.spec.image.transport // empty' <<<"$status")

booted=$(jq -r '.status.booted.image.imageDigest // empty' <<<"$status")
staged=$(jq -r '.status.staged.image.imageDigest // empty' <<<"$status")
# A download-only deployment is staged but locked: bootc-finalize-staged never
# finalizes it at shutdown, so it never boots until it is unlocked.
staged_locked=$(jq -r '.status.staged.downloadOnly // false' <<<"$status")
rollback=$(jq -r '.status.rollback.image.imageDigest // empty' <<<"$status")

write_staged_semaphore() {
    mkdir -p "$RUN_DIR"
    printf 'image=%s\ndigest=%s\nstaged_at=%s\n' \
        "$image" "$1" "$(date --iso-8601=seconds)" >"$RUN_DIR/update-staged"
}

# unlock_staged DIGEST -- unlock the locked deployment that was just staged and
# prove the result: `bootc upgrade --from-downloaded` performs no new fetch and
# reads no image reference, so it cannot pick up a tag that moved after the
# digest check. Afterwards the staged deployment must still be DIGEST and must
# no longer be download-only, or it would never apply.
unlock_staged() { # digest
    local digest=$1 after staged_now locked_now
    bootc upgrade --quiet --from-downloaded
    after=$(bootc status --format json)
    staged_now=$(jq -r '.status.staged.image.imageDigest // empty' <<<"$after")
    locked_now=$(jq -r '.status.staged.downloadOnly // false' <<<"$after")
    if [[ "$staged_now" != "$digest" ]]; then
        echo "ERROR: staged deployment changed during unlock: staged is '${staged_now:-none}', expected $digest" >&2
        return 1
    fi
    if [[ "$locked_now" != false ]]; then
        echo "ERROR: staged deployment is still download-only after unlock, so it will not apply" >&2
        return 1
    fi
}

# Prune BEFORE pulling, not only after a successful switch: a previous run's
# cached image (or a tag that :latest moved away from) otherwise sits in
# /var/lib/containers and the pull needs image-size headroom on top of it —
# observed as ENOSPC on a 20G soak VM. The transfer cache is fully
# re-pullable; only the current tag's image is worth keeping between runs.
podman image prune -f >/dev/null || true

# A failed pull does not invalidate a real deployment staged earlier. Reassert
# it when bootc reports one; otherwise remove a stale runtime semaphore.
if ! pulled_id=$(podman pull --quiet --signature-policy "$BOOTC_POLICY" "$image"); then
    if [[ -n "$staged" ]]; then
        write_staged_semaphore "$staged"
    else
        rm -f "$RUN_DIR/update-staged"
    fi
    exit 1
fi
# The pull prints the image ID that policy actually accepted. Every later
# inspection and the packages capture address that ID, never the mutable tag.
if [[ ! $pulled_id =~ ^[[:xdigit:]]{64}$ ]]; then
    echo "ERROR: podman pull printed no valid image ID: '${pulled_id:-none}'" >&2
    exit 1
fi
pulled=$(podman image inspect --format '{{.Digest}}' "$pulled_id")
if [[ ! $pulled =~ ^sha256:[[:xdigit:]]{64}$ ]]; then
    echo "ERROR: pulled image has no valid registry manifest digest: '${pulled:-none}'" >&2
    exit 1
fi

# The version label CI stamps on published images; matches IMAGE_VERSION in
# os-release, and is the only cross-transport identity (digests differ
# between registry, ISO, and podman-loaded copies of the same build).
remote_version=$(podman image inspect \
    --format '{{index .Config.Labels "org.opencontainers.image.version"}}' \
    "$pulled_id" 2>/dev/null) || remote_version=""

# A registry pull retains both a local storage/config ID (`podman .Id`) and
# the registry manifest digest (`podman .Digest`). bootc records the latter
# (observed on 1.16.8) as imageDigest even when consuming the image through
# containers-storage. The two values are normally different; comparing .Id
# made successful upgrades look like silent failures and made an already
# current image look perpetually out of date.
if [[ "$pulled" == "$booted" ]]; then
    echo "Already running $image ($pulled); nothing to stage."
    write_check current
    exit 0
fi
# held-rollback is decided BEFORE the packages.txt capture: a rollback-equal
# pull is never staged, so ADR-0014's "skip the copy" applies. (Checked ahead
# of the already-staged branch too; a pulled digest cannot equal both.)
if [[ -n "$rollback" && "$pulled" == "$rollback" ]]; then
    # The published image is the deployment the admin rolled back FROM.
    # Do not flip-flop back to it automatically (bootc would refuse anyway:
    # "Target image has the same fs-verity digest as the existing rollback
    # deployment"). Use `bootc rollback` deliberately if that is intended.
    echo "$image ($pulled) equals the rollback deployment; not re-staging automatically."
    write_check held-rollback
    exit 0
fi

# Capture the pulled image's package list to a private temp file BEFORE any
# `bootc switch`/`upgrade` (ADR-0014). A failure here must abort before
# staging: once a deployment is staged, a copy failure can no longer unstage
# it, and the next timer run would only re-assert the semaphore. This applies
# to both the already-staged and the new-stage paths below.
if ! pkg_temp="$(capture_pulled_packages "$pulled_id")"; then
    echo "ERROR: could not extract packages.txt from the pulled image before staging; aborting." >&2
    exit 1
fi

if [[ "$pulled" == "$staged" ]]; then
    # A previous run can stage the deployment locked and then fail or be
    # interrupted before the unlock. Leave it locked and it never applies, so
    # unlock it here before reporting anything.
    if [[ "$staged_locked" == true ]]; then
        echo "Unlocking the download-only deployment already staged for $image."
        if ! unlock_staged "$pulled"; then
            exit 1
        fi
    fi
    echo "$image ($pulled) is already staged; will apply at next reboot."
    # Publish the sidecar FIRST: this branch is what repairs a prior run that
    # staged but failed to publish it (ADR-0014). Then re-assert the semaphore
    # (runtime state; also covers a manual `bootc upgrade`).
    publish_pkg_sidecar "$pulled" "$pkg_temp"
    write_staged_semaphore "$pulled"
    write_check staged
    exit 0
fi

# Refuse early when the local tag no longer points at the image the strict
# policy accepted above. This check is cheap but NOT atomic: bootc resolves the
# mutable local tag again itself, so another root process can retag between
# this check and the staging command.
tag_id=$(podman image inspect --format '{{.Id}}' "$image" 2>/dev/null) || tag_id=""
if [[ "$tag_id" != "$pulled_id" ]]; then
    echo "ERROR: local tag no longer points at the verified image: local tag is '${tag_id:-none}', verified image is $pulled_id" >&2
    exit 1
fi

# Stage LOCKED (download-only), check the staged digest, and unlock only then.
# That closes the race: a deployment staged from a tag that moved stays locked,
# bootc-finalize-staged never finalizes it, and it never boots. A wrong
# deployment can therefore be staged but not applied, and the next run
# replaces it.
echo "Staging update: $image ($pulled), locked until verified"
if [[ "$transport" == "containers-storage" ]]; then
    # The spec already follows containers-storage:<image> — the steady state
    # after the FIRST staged update flips the transport. `bootc switch` to an
    # identical spec is a SILENT no-op (bootc <= 1.16.3 composefs switch
    # returns before staging when new_spec == host.spec), which left every
    # install unable to take a second update while this script reported
    # success (root-caused 2026-07-06 on minisnow). `bootc upgrade` pulls the
    # spec's image and stages it properly.
    bootc upgrade --quiet --download-only
else
    bootc switch --quiet --download-only --transport containers-storage "$image"
fi

# Verify bootc staged the image the strict policy accepted AND that it left the
# deployment locked. Both failure modes here have been observed to be SILENT
# (exit 0), so do not trust the exit code alone.
locked_status=$(bootc status --format json)
staged_now=$(jq -r '.status.staged.image.imageDigest // empty' <<<"$locked_status")
locked_now=$(jq -r '.status.staged.downloadOnly // false' <<<"$locked_status")
if [[ "$staged_now" != "$pulled" ]]; then
    echo "ERROR: staged image is not the verified image; left locked, it will not apply: staged deployment is '${staged_now:-none}', expected $pulled" >&2
    exit 1
fi
if [[ "$locked_now" != true ]]; then
    echo "ERROR: bootc did not lock the staged deployment ('${staged_now:-none}' is not download-only); refusing to report success" >&2
    exit 1
fi
if ! unlock_staged "$pulled"; then
    exit 1
fi

# Publish the staged-package sidecar bound to the staged digest, from the
# temp captured before staging (ADR-0014), THEN write the semaphore, THEN
# prune. Never prune before the sidecar is published.
publish_pkg_sidecar "$pulled" "$pkg_temp"

write_staged_semaphore "$pulled"
write_check staged

# The image content is copied into the composefs repository at switch time;
# prune dangling transfer images to keep podman storage bounded.
podman image prune -f >/dev/null || true

echo "Update staged; it will apply at the next reboot."
