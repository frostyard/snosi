#
# coder-sysext-setup.service: the one unit multi-user.target upholds for coder.
#
# coder.service is not started until CODER_ACCESS_URL has a value: its
# ExecCondition= drop-in (coder.service.d/10-snosi-configured.conf) runs
# /usr/lib/coder-sysext/coder-configured, which exits 1 on an unconfigured
# host. Upholding coder.service is wrong: systemd retries an upheld unit that does not stay
# active, forever (snosi#1100: 93,566 journal lines on one host). So
# 10-coder.conf upholds only this RemainAfterExit oneshot, which stays active
# (no churn) and Wants= coder.service: a Wants= pull is a single clean skip
# while the gate refuses. coder.service keeps its own Restart=on-failure for
# crash recovery. Found by
# shared/sysext/finalize/sysext-upholds-guard.sh (snosi#1113). Same pattern as
# k3s-sysext-setup.service and himmelblau-sysext-setup.service.

[Unit]
Description=Coder Sysext Activation
Documentation=https://coder.com/docs
Wants=coder.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true

[Install]
WantedBy=multi-user.target
