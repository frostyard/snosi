#!/bin/bash
set -euo pipefail

if [[ "${DEBUG_BUILD:-0}" == "1" ]]; then
    set -x
fi

# shellcheck disable=SC1091
source "$SRCDIR/shared/download/verified-download.sh"
# shellcheck disable=SC1091
source "$SRCDIR/shared/download/deb-dependencies.sh"
DEBS=$(mktemp -d)
trap 'rm -rf "$DEBS"' EXIT
verified_download "sunshine" "$DEBS/sunshine.deb"

# Upstream's CPack Depends (cmake/packaging/linux.cmake) appends the Qt5
# branch of TRAY_QT_VERSION -- "libqt5widgets5, libqt5svg5" -- while the
# shipped binary links Qt6 only (readelf DT_NEEDED: libQt6Widgets/Gui/Core,
# nothing from Qt5; the Qt6 entries dpkg-shlibdeps added later in the same
# line are the real ones). dpkg enforces every Depends entry, so installing
# as-is would drag ~35 MB of never-loaded Qt5 into the delta. Strip exactly
# that pair and rebuild the deb (edge does the same for its postinst hooks).
# Fail closed if the pair is absent: upstream fixed its packaging, so delete
# this block rather than letting a silent no-op hide the change.
# The raw field keeps CMake's line-continuation indentation (runs of spaces
# between entries; dpkg-deb --field normalizes them away), so match on
# whitespace runs rather than an exact substring.
dpkg-deb -R "$DEBS/sunshine.deb" "$DEBS/unpacked"
control="$DEBS/unpacked/DEBIAN/control"
bogus_qt5='libqt5widgets5,[[:space:]]*libqt5svg5,[[:space:]]*'
if ! grep -Eq "$bogus_qt5" "$control"; then
    printf 'Sunshine control no longer lists the bogus Qt5 Depends pair (/%s/); remove this workaround\n' \
        "$bogus_qt5" >&2
    exit 1
fi
sed -E -i "s/$bogus_qt5//" "$control"
if grep -Eq 'libqt5' "$control"; then
    printf 'Sunshine control still references Qt5 after the strip: %s\n' \
        "$(dpkg-deb --field "$DEBS/sunshine.deb" Depends)" >&2
    exit 1
fi
# Upstream ships its maintainer scripts mode 0644 (every release so far).
# dpkg -i tolerates that, but dpkg-deb -b refuses to pack it, so restore the
# mode dpkg itself would have applied before rebuilding.
for script in preinst postinst prerm postrm; do
    if [[ -f "$DEBS/unpacked/DEBIAN/$script" ]]; then
        chmod 0755 "$DEBS/unpacked/DEBIAN/$script"
    fi
done
dpkg-deb -b "$DEBS/unpacked" "$DEBS/sunshine-fixed.deb" >/dev/null
assert_deb_dependencies_satisfied "$DEBS/sunshine-fixed.deb"

dpkg -i "$DEBS/sunshine-fixed.deb"

# libcap2-bin is supplied by base; fail closed if it no longer provides getcap.
if command -v getcap >/dev/null; then
    getcap_bin=$(command -v getcap)
elif [[ -x /usr/sbin/getcap ]]; then
    getcap_bin=/usr/sbin/getcap
else
    printf 'Sunshine capability assertion requires getcap\n' >&2
    exit 1
fi

normalize_capabilities() {
    local capability_names capability_flags
    capability_names=${1%=*}
    capability_flags=${1##*=}
    capability_names=$(printf '%s\n' "$capability_names" | tr ',' '\n' | LC_ALL=C sort | paste -sd, -)
    printf '%s=%s\n' "$capability_names" "$capability_flags"
}

capability_output=$("$getcap_bin" /usr/bin/sunshine)
actual_capabilities=${capability_output#* }
expected_capabilities='cap_sys_admin,cap_sys_nice=p'
if [[ $(normalize_capabilities "$actual_capabilities") != \
    $(normalize_capabilities "$expected_capabilities") ]]; then
    printf 'Sunshine capability assertion failed: expected %s, got %s\n' \
        "$expected_capabilities" "$actual_capabilities" >&2
    exit 1
fi
