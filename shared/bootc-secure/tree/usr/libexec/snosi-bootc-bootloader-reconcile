#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Reconcile shim's MOK-signed systemd-boot second stage from the booted image.
set -euo pipefail

readonly SOURCE="${SNOSI_BOOTC_RECONCILE_SOURCE:-/usr/lib/snosi/bootc/systemd-bootx64.efi}"
readonly CERT="${SNOSI_BOOTC_RECONCILE_CERT:-/usr/lib/snosi/mok.crt}"
readonly RUN_DIR="${SNOSI_BOOTC_RECONCILE_RUN_DIR:-/run/snosi-bootloader-reconcile}"
readonly ESP_LIBRARY="${SNOSI_ESP_LIBRARY:-/usr/lib/snosi/esp.sh}"
readonly SECUREBOOT_VAR="${SNOSI_BOOTC_RECONCILE_SECUREBOOT_VAR:-/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c}"
readonly EFIVARS_DIR="${SECUREBOOT_VAR%/*}"
RECONCILE_TEMP=""
RECONCILE_BACKUP=""

die() { printf 'snosi-bootc-bootloader-reconcile: %s\n' "$*" >&2; exit 1; }

# True only when efivarfs is mounted, accessible and lists variables. A mounted
# efivarfs on UEFI firmware always lists variables, so an empty listing is not
# proof that the firmware exposes its variable store.
efivarfs_readable() {
    local fstype first

    [[ -d "$EFIVARS_DIR" && -r "$EFIVARS_DIR" && -x "$EFIVARS_DIR" ]] || return 1
    fstype=$(stat -f -c %T -- "$EFIVARS_DIR" 2>/dev/null) || return 1
    [[ $fstype == efivarfs ]] || return 1
    first=$(find "$EFIVARS_DIR" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null) || return 1
    [[ -n $first ]]
}

# Print the UEFI Secure Boot state from efivarfs: 1 is enabled, 0 is disabled,
# unsupported means efivarfs is readable but has no SecureBoot variable (UEFI
# defines it only on firmware that supports Secure Boot; #1160). Every other
# case returns non-zero so the caller can treat the state as unknown and fail
# closed: efivarfs missing, not mounted, unreadable or empty; a SecureBoot
# entry that is a dangling symlink, not a regular file or not readable; and a
# truncated or non-boolean value.
read_secureboot_state() {
    local value

    if [[ ! -e "$SECUREBOOT_VAR" && ! -L "$SECUREBOOT_VAR" ]]; then
        efivarfs_readable || return 1
        printf 'unsupported\n'
        return 0
    fi
    [[ -f "$SECUREBOOT_VAR" && -r "$SECUREBOOT_VAR" ]] || return 1
    value=$(od -An -t u1 -j4 -N1 "$SECUREBOOT_VAR" 2>/dev/null) || return 1
    value="${value//[[:space:]]/}"
    [[ $value == 0 || $value == 1 ]] || return 1
    printf '%s\n' "$value"
}

cleanup() {
    set +e
    [[ -z "$RECONCILE_TEMP" ]] || rm -f -- "$RECONCILE_TEMP"
    [[ -z "$RECONCILE_BACKUP" ]] || rm -f -- "$RECONCILE_BACKUP"
    if declare -F snosi_esp_cleanup >/dev/null; then
        snosi_esp_cleanup
    fi
}

main() {
    local destination_dir destination secureboot
    trap cleanup EXIT

    [[ -r "$ESP_LIBRARY" ]] || die "ESP support library is missing"
    # shellcheck source=/dev/null
    source "$ESP_LIBRARY"
    [[ -f "$SOURCE" ]] || die "immutable systemd-boot source is missing"
    [[ -f "$CERT" ]] || die "MOK certificate is missing"
    sbverify --cert "$CERT" "$SOURCE" >/dev/null || die "immutable systemd-boot source is not MOK-signed"

    snosi_esp_resolve "$RUN_DIR" root ||
        die "unable to identify a writable EFI System Partition"

    destination_dir="$SNOSI_ESP_MOUNTPOINT/EFI/BOOT"
    destination="$destination_dir/grubx64.efi"
    if [[ ! -d "$destination_dir" || ! -f "$destination" ]]; then
        # An install that boots systemd-boot directly, without shim, has no
        # second stage to reconcile. Skip only when Secure Boot is definitely
        # disabled (#928) or the firmware does not support it (#1160); an
        # enabled or unknown state still fails closed.
        secureboot=$(read_secureboot_state) || secureboot=unknown
        case $secureboot in
            0)
                printf 'snosi-bootc-bootloader-reconcile: Secure Boot is disabled and no shim second stage is installed; nothing to reconcile\n' >&2
                exit 0
                ;;
            unsupported)
                printf 'snosi-bootc-bootloader-reconcile: firmware has no Secure Boot support (no SecureBoot variable in efivarfs) and no shim second stage is installed; nothing to reconcile\n' >&2
                exit 0
                ;;
        esac
        die "installed shim second stage is missing"
    fi
    # The source lives under /usr so an existing /boot ESP mount cannot shadow it.
    if cmp -s "$SOURCE" "$destination"; then
        exit 0
    fi

    RECONCILE_TEMP=$(mktemp "$destination_dir/.snosi-grubx64.efi.XXXXXX")
    cp "$SOURCE" "$RECONCILE_TEMP"
    sbverify --cert "$CERT" "$RECONCILE_TEMP" >/dev/null || die "temporary systemd-boot copy is not MOK-signed"
    sync -f "$RECONCILE_TEMP"

    # Preserve the existing second stage until the replacement is durable.
    RECONCILE_BACKUP=$(mktemp "$destination_dir/.snosi-grubx64.efi.previous.XXXXXX")
    cp "$destination" "$RECONCILE_BACKUP"
    sync -f "$RECONCILE_BACKUP"
    mv -f -- "$RECONCILE_TEMP" "$destination"
    RECONCILE_TEMP=""
    if ! sync -f "$destination" || ! sync -f "$destination_dir"; then
        mv -f -- "$RECONCILE_BACKUP" "$destination" || die "replacement sync failed and prior second stage could not be restored"
        RECONCILE_BACKUP=""
        sync -f "$destination" || die "prior second stage restoration could not be synced"
        sync -f "$destination_dir" || die "prior second stage restoration directory could not be synced"
        die "replacement sync failed; prior second stage restored"
    fi
    rm -f -- "$RECONCILE_BACKUP"
    RECONCILE_BACKUP=""
}

main "$@"
