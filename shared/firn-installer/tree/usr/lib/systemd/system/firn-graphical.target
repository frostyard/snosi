# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Boot target of the ISO's "Install snosi (graphical)" GRUB entry
# (systemd.unit=firn-graphical.target, shared/firn-installer/tools/build-iso.sh).
# It pulls firn-gui.service onto tty1 through the static
# firn-graphical.target.wants/ link, in place of the TUI kiosk; the serial
# kiosk and the flatpak seed stay in multi-user.target.wants/ and run under
# both entries, so a serial-only machine always gets the console installer
# (docs/adr/0022-installer-graphical-and-console-boot-entries.md).
# Modelled on systemd's graphical.target.
[Unit]
Description=firn installer (graphical)
Requires=multi-user.target
Conflicts=rescue.service rescue.target
After=multi-user.target rescue.service rescue.target
AllowIsolate=yes
