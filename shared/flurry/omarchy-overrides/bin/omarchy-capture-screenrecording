#!/bin/bash

# omarchy:summary=Capture a screen recording

# snosi override: gpu-screen-recorder (AUR) is not shipped on Flurry yet;
# tracked as a follow-up. Keep the binding from failing silently.

notify-send "Screen recording unavailable" "gpu-screen-recorder is not shipped on Flurry yet." -u critical 2>/dev/null || \
  echo "Screen recording unavailable: gpu-screen-recorder is not shipped on Flurry yet." >&2
exit 1
