#!/bin/bash

# omarchy:summary=Install RetroArch and common emulator cores
# omarchy:requires-sudo=false

# snosi override: the Arch libretro package set is remapped to the Flathub
# RetroArch, which bundles core management (Flatpak is the app path on
# Flurry).

set -e
flatpak install -y --noninteractive flathub org.libretro.RetroArch
omarchy-refresh-applications || true
echo "RetroArch installed from Flathub. Install cores from inside RetroArch (Online Updater)."
