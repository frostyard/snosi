#!/bin/bash

# omarchy:summary=Returns true if any of the named packages are missing from the system (or false if they're all there).
# omarchy:args=<packages...>

# snosi override: Debian dpkg + PATH + Arch-name mapping instead of pacman
# (see omarchy-pkg-present; shared resolution in omarchy-snosi-lib).

source /usr/share/omarchy/bin/omarchy-snosi-lib

for pkg in "$@"; do
  snosi_pkg_present_one "$pkg" || exit 0
done

exit 1
