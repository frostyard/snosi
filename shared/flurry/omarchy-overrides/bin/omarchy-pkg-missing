#!/bin/bash

# omarchy:summary=Returns true if any of the named packages are missing from the system (or false if they're all there).
# omarchy:args=<packages...>

# snosi override: Debian dpkg instead of pacman; callers often pass Arch
# package names, so fall back to a same-named command on PATH.

for pkg in "$@"; do
  if ! dpkg -s "$pkg" &>/dev/null && ! command -v "$pkg" &>/dev/null; then
    exit 0
  fi
done

exit 1
