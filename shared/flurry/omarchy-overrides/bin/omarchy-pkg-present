#!/bin/bash

# omarchy:summary=Returns true if all of the named packages are installed on the system (or false if any of them are missing).
# omarchy:args=<packages...>

# snosi override: Debian dpkg + PATH + Arch-name mapping instead of pacman
# (resolution rules live in omarchy-snosi-lib::snosi_pkg_present_one --
# root-caused 2026-08-26: gating names like voxtype-bin never matched the
# shipped voxtype deb, so menus mis-reported availability).

source /usr/share/omarchy/bin/omarchy-snosi-lib

for pkg in "$@"; do
  snosi_pkg_present_one "$pkg" || exit 1
done

exit 0
