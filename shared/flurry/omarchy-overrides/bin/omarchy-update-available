#!/bin/bash

# omarchy:summary=Check whether Omarchy updates are available.

# snosi override: reads the snosi update checker's state file (written by
# bootc-update-stage on every run; see CLAUDE.md "OS Update Staging").

set -euo pipefail

state=/run/snosi/update-check
if [[ -f /run/snosi/update-staged ]]; then
  echo "OS update staged -- reboot to apply"
  exit 0
fi
if [[ -r $state ]]; then
  outcome=$(sed -n 's/^outcome=//p' "$state" | head -1)
  case "$outcome" in
    staged) echo "OS update staged -- reboot to apply"; exit 0 ;;
    current) echo "Omarchy is up to date"; exit 1 ;;
    failed) echo "The last update check failed -- see 'snosi-update-status'"; exit 1 ;;
    held-rollback) echo "Update held (matches the rolled-back deployment)"; exit 1 ;;
  esac
fi
echo "No update check has run yet -- run 'omarchy-update'"
exit 1
