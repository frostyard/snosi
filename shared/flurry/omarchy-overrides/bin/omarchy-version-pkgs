#!/bin/bash

# omarchy:summary=Print when system packages were last upgraded

# snosi override: system packages change only with the image; print the
# image build date.

if [[ -r /usr/share/frostyard/flurry_build_date ]]; then
  date -d "$(cat /usr/share/frostyard/flurry_build_date)" "+%A, %B %d %Y at %H:%M"
else
  echo "unknown (image build date not recorded)"
fi
