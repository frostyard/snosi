#!/bin/bash
set -euo pipefail

# Vendors basecamp/omarchy (pinned commit in shared/download/image-checksums.json)
# into the flurry image, following omarchy's own docs/file-layout.md install
# mapping with the Arch-only pieces (pacman/libalpm, mkinitcpio, limine,
# snapper) removed, then applies the snosi override layer from
# shared/flurry/omarchy-overrides/ for commands whose Arch mechanics are
# replaced by snosi ones (apt-image updates via bootc, A/B rollback instead
# of snapper, flatpak/brew/mise/sysexts instead of pacman/AUR).
#
# Writes to $DESTDIR only (never $SRCDIR — frostyard/snosi#293). BuildScript
# $DESTDIR output lands in the image BEFORE PostInstallationScripts run, so
# the omarchy plymouth theme installed here is visible to the dracut
# postinst that generates the final initrd.

source "$SRCDIR/shared/download/verified-download.sh"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

ARCHIVE="$TMP/omarchy.tar.gz"
verified_download "omarchy" "$ARCHIVE"
tar -xzf "$ARCHIVE" -C "$TMP"
SRC=$(find "$TMP" -maxdepth 1 -type d -name 'omarchy-*' | head -n 1)
[[ -n "$SRC" ]] || { echo "omarchy.chroot: extracted source dir not found" >&2; exit 1; }

OMARCHY="$DESTDIR/usr/share/omarchy"
SKEL="$DESTDIR/etc/skel"

# --- /usr/share/omarchy: the runtime tree ----------------------------------
mkdir -p "$OMARCHY"
cp -a "$SRC"/. "$OMARCHY"/
# On-machine agent skills: omarchy-provision-user symlinks every directory
# under default/agents/skills/ into each user's agent skill dirs
# (~/.claude/skills, ~/.codex/skills, ...). Upstream ships the end-user
# `omarchy` skill there; we add two:
# 1. The Quickshell plugin/IPC guide (upstream keeps it repo-only at
#    agents/skills/shell-dev.md) wrapped as an installable skill, so
#    on-machine agents can WRITE shell plugins/applets, not just configs.
#    Deliberate divergence from upstream's install set; grep-guarded so a
#    re-pin that moves the file forces a re-triage.
[[ -f "$OMARCHY/agents/skills/shell-dev.md" ]] || {
    echo "omarchy.chroot: agents/skills/shell-dev.md vanished upstream -- re-triage the shell-dev skill vendoring" >&2
    exit 1
}
mkdir -p "$OMARCHY/default/agents/skills/omarchy-shell-dev"
{
    cat <<'FRONTMATTER'
---
name: omarchy-shell-dev
description: >
  Write or modify Quickshell plugins/widgets/applets for the omarchy shell
  (bar widgets, panels, IPC handlers). Use when creating a plugin under
  ~/.config/omarchy/plugins/, editing manifest.json, calling omarchy-shell
  IPC, or extending the bar beyond what shell.json configures. The plain
  omarchy skill covers configuration; this one covers plugin CODE.
---

FRONTMATTER
    cat "$OMARCHY/agents/skills/shell-dev.md"
} >"$OMARCHY/default/agents/skills/omarchy-shell-dev/SKILL.md"
# 2. The Flurry-deltas skill (snosi-authored): stops on-machine agents
#    giving Arch/pacman advice on this Debian image-based system.
mkdir -p "$OMARCHY/default/agents/skills/flurry"
install -m 0644 "$SRCDIR/shared/flurry/agent-skills/flurry/SKILL.md" \
    "$OMARCHY/default/agents/skills/flurry/SKILL.md"

# Repo-only content that is never installed (omarchy's PKGBUILD excludes
# these too) and Arch-only machinery that must not ship on Debian/immutable.
rm -rf "$OMARCHY"/.github "$OMARCHY"/.editorconfig "$OMARCHY"/.gitignore \
    "$OMARCHY"/docs "$OMARCHY"/manual "$OMARCHY"/test "$OMARCHY"/plans \
    "$OMARCHY"/agents \
    "$OMARCHY"/default/libalpm "$OMARCHY"/default/limine \
    "$OMARCHY"/default/snapper "$OMARCHY"/default/pacman \
    "$OMARCHY"/default/systemd/system/supergfxd.service.d

# --- omarchy CLI on PATH ----------------------------------------------------
mkdir -p "$DESTDIR/usr/bin"
for f in "$OMARCHY"/bin/*; do
    [[ -f "$f" && -x "$f" ]] || continue
    ln -sf "/usr/share/omarchy/bin/$(basename "$f")" "$DESTDIR/usr/bin/$(basename "$f")"
done

# --- /etc/skel seeding ------------------------------------------------------
# config/ is omarchy's user-dotfile seed; useradd -m and the snosi installer
# both copy /etc/skel into new homes.
mkdir -p "$SKEL/.config"
cp -a "$SRC/config"/. "$SKEL/.config"/
cp -f "$SRC/default/bashrc" "$SKEL/.bashrc"
# Hyprland toggles are generated state, seeded under .local/state.
mkdir -p "$SKEL/.local/state/omarchy/toggles/hypr"
cp -a "$SRC/default/hypr/toggles"/. "$SKEL/.local/state/omarchy/toggles/hypr"/
# Nautilus python extensions (needs python3-nautilus).
if [[ -d "$SRC/default/nautilus-python/extensions" ]]; then
    mkdir -p "$SKEL/.local/share/nautilus-python/extensions"
    cp -a "$SRC/default/nautilus-python/extensions"/. "$SKEL/.local/share/nautilus-python/extensions"/
fi
# Shipped web-app/TUI launchers.
mkdir -p "$SKEL/.local/share/applications"
cp -a "$SRC/applications"/*.desktop "$SKEL/.local/share/applications"/
# Branding text used by omarchy-about/screensaver.
mkdir -p "$SKEL/.config/omarchy/branding"
cp -f "$SRC/logo.txt" "$SKEL/.config/omarchy/branding/screensaver.txt"
cp -f "$SRC/icon.txt" "$SKEL/.config/omarchy/branding/about.txt"
# Mark every shipped migration as already applied for new users (omarchy
# packaging does the same: all flurry users are new users; migrations only
# matter for pre-existing homes across omarchy re-pins).
mkdir -p "$SKEL/.local/state/omarchy/migrations"
for m in "$SRC"/migrations/*.sh; do
    [[ -f "$m" ]] || continue
    touch "$SKEL/.local/state/omarchy/migrations/$(basename "$m")"
done

# --- application icons ------------------------------------------------------
mkdir -p "$DESTDIR/usr/share/icons/hicolor/256x256/apps" "$DESTDIR/usr/share/pixmaps"
cp -a "$SRC/applications/icons"/. "$DESTDIR/usr/share/icons/hicolor/256x256/apps"/
cp -f "$SRC/icon.png" "$DESTDIR/usr/share/pixmaps/omarchy.png"

# --- /etc drop-ins ----------------------------------------------------------
# Straight copies of the omarchy-owned /etc payload; Arch-only trees are
# excluded (mkinitcpio, limine-entry-tool, pacman gnupg). nsswitch.conf is
# skipped: Debian's libnss-mdns manages its own nsswitch lines.
for d in NetworkManager modprobe.d profile.d sddm.conf.d security sudoers.d \
         sysctl.d systemd tmpfiles.d fastfetch cups docker; do
    [[ -d "$SRC/etc/$d" ]] || continue
    mkdir -p "$DESTDIR/etc/$d"
    cp -a "$SRC/etc/$d"/. "$DESTDIR/etc/$d"/
done
cp -f "$SRC/etc/plymouth/plymouthd.conf" "$DESTDIR/etc/plymouth/plymouthd.conf" 2>/dev/null || true
# Sudoers rules for tools flurry does not ship.
rm -f "$DESTDIR/etc/sudoers.d/omarchy-asdcontrol" "$DESTDIR/etc/sudoers.d/omarchy-tzupdate"
# Docker daemon.json belongs to the docker sysext on snosi, and docker's DNS
# resolved drop-in with it; keep both out until the sysext integration lands.
rm -rf "$DESTDIR/etc/docker" "$DESTDIR/etc/systemd/resolved.conf.d/20-docker-dns.conf"

# --- /usr system integration ------------------------------------------------
install -D -m 0644 "$SRC/default/environment.d/10-omarchy-fcitx.conf" \
    "$DESTDIR/usr/lib/environment.d/10-omarchy-fcitx.conf"
mkdir -p "$DESTDIR/usr/share/uwsm/env.d"
cp -a "$SRC/default/uwsm/env.d"/. "$DESTDIR/usr/share/uwsm/env.d"/
install -D -m 0644 "$SRC/default/fontconfig/conf.avail/50-omarchy.conf" \
    "$DESTDIR/usr/share/fontconfig/conf.avail/50-omarchy.conf"
mkdir -p "$DESTDIR/etc/fonts/conf.d"
ln -sf /usr/share/fontconfig/conf.avail/50-omarchy.conf "$DESTDIR/etc/fonts/conf.d/50-omarchy.conf"
mkdir -p "$DESTDIR/usr/share/xdg-terminal-exec"
cp -a "$SRC/default/xdg-terminal-exec"/. "$DESTDIR/usr/share/xdg-terminal-exec"/
install -D -m 0644 "$SRC/default/applications/mimeapps.list" \
    "$DESTDIR/usr/share/applications/mimeapps.list"
# omarchy user units + drop-ins.
mkdir -p "$DESTDIR/usr/lib/systemd/user"
cp -a "$SRC/default/systemd/user"/. "$DESTDIR/usr/lib/systemd/user"/
install -D -m 0644 "$SRC/default/systemd/faster-shutdown.conf" \
    "$DESTDIR/usr/lib/systemd/system/user@.service.d/20-omarchy-faster-shutdown.conf"
mkdir -p "$DESTDIR/usr/lib/systemd/system-sleep"
cp -a "$SRC/default/systemd/system-sleep"/. "$DESTDIR/usr/lib/systemd/system-sleep"/
mkdir -p "$DESTDIR/usr/lib/systemd/zram-generator.conf.d"
cp -a "$SRC/default/systemd/zram-generator.conf.d"/. "$DESTDIR/usr/lib/systemd/zram-generator.conf.d"/
# udev rules
install -D -m 0644 "$SRC/default/udev/framework16-qmk-hid.rules" \
    "$DESTDIR/usr/lib/udev/rules.d/99-omarchy-framework16-qmk-hid.rules"
# omarchy icon font
mkdir -p "$DESTDIR/usr/share/fonts/omarchy"
cp -a "$SRC/default/fonts/omarchy"/. "$DESTDIR/usr/share/fonts/omarchy"/
# wireplumber defaults
if [[ -d "$SRC/default/wireplumber/wireplumber.conf.d" ]]; then
    mkdir -p "$DESTDIR/usr/share/wireplumber/wireplumber.conf.d"
    cp -a "$SRC/default/wireplumber/wireplumber.conf.d"/. "$DESTDIR/usr/share/wireplumber/wireplumber.conf.d"/
fi

# --- session: SDDM + uwsm + plymouth ---------------------------------------
mkdir -p "$DESTDIR/usr/share/sddm/themes/omarchy"
cp -a "$SRC/default/sddm/omarchy"/. "$DESTDIR/usr/share/sddm/themes/omarchy"/
install -D -m 0644 "$SRC/default/sddm/hyprland.lua" "$DESTDIR/usr/share/sddm/hyprland.lua"
# /usr/share, not Arch's /usr/local/share: /usr/local is /var-backed on snosi.
install -D -m 0644 "$SRC/default/wayland-sessions/omarchy.desktop" \
    "$DESTDIR/usr/share/wayland-sessions/omarchy.desktop"
mkdir -p "$DESTDIR/usr/share/plymouth/themes/omarchy"
cp -a "$SRC/default/plymouth"/. "$DESTDIR/usr/share/plymouth/themes/omarchy"/

# --- chromium integration ---------------------------------------------------
# Debian's chromium wrapper reads /etc/chromium.d/* (not Arch's
# chromium-flags.conf); translate the vendored flags file.
if [[ -f "$SRC/config/chromium-flags.conf" ]]; then
    mkdir -p "$DESTDIR/etc/chromium.d"
    {
        echo "# Generated from omarchy config/chromium-flags.conf by omarchy.chroot"
        while IFS= read -r line; do
            [[ -n "$line" && "$line" != \#* ]] || continue
            printf 'CHROMIUM_FLAGS="$CHROMIUM_FLAGS %s"\n' "$line"
        done <"$SRC/config/chromium-flags.conf"
    } >"$DESTDIR/etc/chromium.d/omarchy-flags"
fi
if [[ -d "$SRC/default/chromium/native-messaging-hosts" ]]; then
    mkdir -p "$DESTDIR/etc/chromium/native-messaging-hosts"
    cp -a "$SRC/default/chromium/native-messaging-hosts"/. "$DESTDIR/etc/chromium/native-messaging-hosts"/
fi

# --- trixie compat patches --------------------------------------------------
# Surgical, grep-guarded edits for version drift between omarchy's Arch
# baseline and Debian trixie(-backports). Each guard fails the build when an
# omarchy re-pin changes the patched code, forcing a re-triage instead of a
# silently broken or stale patch. Remove each patch when the noted package
# version reaches the image.
compat_patch() { # file grep-pattern sed-expr note
    local f="$1" pat="$2" sed_expr="$3" note="$4"
    grep -qF "$pat" "$f" || {
        echo "omarchy.chroot: compat patch target vanished ($note): $pat not in $f" >&2
        exit 1
    }
    sed -i "$sed_expr" "$f"
}
# Hyprland 0.55.2: the Lua monitor object has no .reserved yet (added for
# 0.56); qconsole.lua:71 crashes the whole config on the nil index. Zero
# reserved area only mis-sizes the drop-down console slightly. Remove when
# hyprland >= 0.56 lands in trixie-backports.
compat_patch "$OMARCHY/default/hypr/qconsole.lua" \
    'local reserved = monitor.reserved' \
    's/local reserved = monitor\.reserved$/local reserved = monitor.reserved or { top = 0, bottom = 0 }/' \
    'hyprland 0.55.2 monitor.reserved'
# foot 1.21 (trixie) predates the [colors-dark] section name; omarchy's
# theme engine rewrites the generated foot.ini on every theme switch, so a
# plain [colors] section is behavior-equivalent. Remove when foot >= 1.23
# is available from trixie(-backports).
for f in "$OMARCHY/default/themed/foot.ini.tpl" "$OMARCHY/default/foot/screensaver.ini"; do
    compat_patch "$f" '[colors-dark]' 's/^\[colors-dark\]$/[colors]/' 'foot 1.21 colors-dark'
done
# foot 1.21 also rejects a `cursor=` key inside a colors section (newer foot
# accepts it there); move the template's cursor line to its own [cursor]
# section, where 1.21 has always accepted `color=`. Same removal condition
# as above. (screensaver.ini carries no cursor key -- only the template.)
f="$OMARCHY/default/themed/foot.ini.tpl"
grep -q '^cursor=' "$f" || {
    echo "omarchy.chroot: compat patch target vanished (foot 1.21 cursor key): no ^cursor= in $f" >&2
    exit 1
}
cursor_line=$(grep -m1 '^cursor=' "$f" | sed 's/^cursor=//')
sed -i '/^cursor=/d' "$f"
printf '\n[cursor]\ncolor=%s\n' "$cursor_line" >>"$f"
# Qt 6.8 (trixie) still treats `transient` as a QML reserved word (Java
# future-reserved set, unreserved in Qt 6.9), so the notifications plugin
# fails to parse and the shell loses its notification daemon. Rename the
# local. Remove when Qt >= 6.9 / a newer quickshell stack reaches trixie.
compat_patch "$OMARCHY/shell/plugins/notifications/Service.qml" \
    'var transient = false' \
    's/\btransient\b/xTransient/g; s/xTransient` hint/transient` hint/; s/hints\["xTransient"\]/hints["transient"]/' \
    'Qt 6.8 reserved word transient'
# Homebrew on PATH (frostyard/snosi#777): omarchy's env-bootstrap is the
# single PATH authority for every shell entry point (skel .bashrc, uwsm
# session env, profile.d login shells, the bash rc chain), and it knows
# nothing of snosi's /home/linuxbrew tree (unpacked by brew-setup.service)
# -- yet the omarchy-pkg-* overrides point users at `brew install`. Append
# a dedup-guarded brew bin dir before the final `export PATH`, same
# append-not-prepend precedence policy as the user tool paths above. Not a
# sed one-liner, so guarded by hand like compat_patch: an omarchy re-pin
# that restructures env-bootstrap fails the build for re-triage.
EB="$OMARCHY/default/bash/env-bootstrap"
grep -qx 'export PATH' "$EB" || {
    echo "omarchy.chroot: compat patch target vanished (brew PATH): no bare 'export PATH' line in $EB" >&2
    exit 1
}
! grep -q linuxbrew "$EB" || {
    echo "omarchy.chroot: compat patch target vanished (brew PATH): $EB already mentions linuxbrew" >&2
    exit 1
}
brew_block=$(cat <<'BREW'
# snosi (Flurry): Homebrew lives at /home/linuxbrew (unpacked on first boot
# by brew-setup.service); appended so system binaries keep precedence.
if [ -d /home/linuxbrew/.linuxbrew/bin ]; then
  case ":$PATH:" in
    *":/home/linuxbrew/.linuxbrew/bin:"*) ;;
    *) PATH="${PATH:+$PATH:}/home/linuxbrew/.linuxbrew/bin" ;;
  esac
fi
BREW
)
awk -v block="$brew_block" '/^export PATH$/ { print block; print ""; } { print }' "$EB" >"$EB.tmp"
mv "$EB.tmp" "$EB"
sh -n "$EB" || { echo "omarchy.chroot: patched env-bootstrap fails sh -n" >&2; exit 1; }

# --- snosi override layer ---------------------------------------------------
# Whole-file replacements for commands whose Arch mechanics are remapped;
# each keeps the `# omarchy:` header metadata so the CLI router and menu
# still list them.
OVR="$SRCDIR/shared/flurry/omarchy-overrides"
if [[ -d "$OVR/bin" ]]; then
    for f in "$OVR"/bin/*; do
        [[ -f "$f" ]] || continue
        install -m 0755 "$f" "$OMARCHY/bin/$(basename "$f")"
    done
fi
# first-run user-unit enablement is preset-driven on snosi (see
# shared/flurry/tree/usr/lib/systemd/user-preset/90-flurry.preset).
if [[ -f "$OVR/install/user/first-run/enable-user-units.sh" ]]; then
    install -m 0755 "$OVR/install/user/first-run/enable-user-units.sh" \
        "$OMARCHY/install/user/first-run/enable-user-units.sh"
fi

# --- neutralization guard ---------------------------------------------------
# check-runtime-etc-guard.sh never sees vendored content, so enforce the
# runtime-enablement ban here: any system-scope `systemctl enable|disable|
# mask` remaining in the installed omarchy bin/ must be triaged (override it
# or allowlist the exact file in omarchy-neutralize-allow.txt). Fails closed
# when a future omarchy re-pin introduces new calls.
ALLOW="$SRCDIR/shared/flurry/omarchy-neutralize-allow.txt"
violations=$(grep -rnE 'systemctl[^|;&]*\b(enable|disable|mask)\b' "$OMARCHY/bin" \
    | grep -vE 'systemctl[^|;&]*--user' \
    | { [[ -s "$ALLOW" ]] && grep -v -F -f <(grep -v '^#' "$ALLOW" | grep -v '^$') || cat; } ) || true
if [[ -n "$violations" ]]; then
    echo "omarchy.chroot: unneutralized system-scope systemctl enablement calls:" >&2
    echo "$violations" >&2
    exit 1
fi

# --- permissions ------------------------------------------------------------
# Trust the tarball's file modes (upstream ships correct ones -- a blanket
# 644 sweep stripped exec bits from shell/plugins/*/capture.sh and broke the
# clipboard plugin, root-caused 2026-08-25 in the first booted session).
# Only normalize directories and guarantee the CLI + override layer are
# executable.
find "$OMARCHY" -type d -exec chmod 755 {} +
chmod 755 "$OMARCHY"/bin/*
[[ -f "$OMARCHY/install/user/first-run/enable-user-units.sh" ]] && \
    chmod 755 "$OMARCHY/install/user/first-run/enable-user-units.sh"

echo "omarchy vendored to /usr/share/omarchy (pinned $(basename "$SRC" | sed 's/^omarchy-//'))"
