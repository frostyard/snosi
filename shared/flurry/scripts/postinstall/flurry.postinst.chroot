#!/bin/bash
set -euo pipefail

echo "Running post-installation customizations..."

# Common post-installation steps (os-release, mounts, cleanup, sysext infra)
OS_PRETTY_NAME="Flurry Linux"
OS_NAME="Flurry Linux"
source "$SRCDIR"/shared/scripts/common-postinst.sh

# Enable SDDM. Build-time enable is the sanctioned path: the image finalize
# strips the /etc alias into the enablement manifest and drops
# display-manager.service from it (Debian DMs carry no Alias= in [Install],
# so presets cannot recreate it) -- the static /usr alias in
# shared/flurry/tree/usr/lib/systemd/system/display-manager.service is what
# actually selects SDDM on every boot.
systemctl enable sddm.service

# Omarchy strips gnome-keyring from SDDM's PAM stack (install/login/sddm.sh):
# no encrypted login keyring is created; omarchy provisions a passwordless
# default keyring per user instead. Debian's libpam-gnome-keyring hooks into
# the common PAM stack via pam-auth-update, so remove its profile activation
# for the sddm service only.
if [ -f /etc/pam.d/sddm ]; then
    sed -i '/pam_gnome_keyring\.so/d' /etc/pam.d/sddm
fi

echo "Post-installation complete."
