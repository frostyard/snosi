# User-scope preset policy for flurry desktops. Applied at image build by
# mkosi (`systemctl --global preset-all`) and again on first boot by
# preset-global.service. This replaces omarchy's
# install/user/first-run/enable-user-units.sh (overridden to a no-op by
# shared/flurry/omarchy-overrides/), keeping enablement out of runtime
# scripts per the snosi preset policy. Units not listed fall through to
# systemd's default-enable (pipewire, wireplumber, etc.).

# Omarchy user services (vendored to /usr/lib/systemd/user by
# shared/flurry/scripts/build/omarchy.chroot); all are Condition-gated in
# the units themselves.
enable bt-agent.service
enable omarchy-fcitx5.service
enable omarchy-sleep-lock.service
enable omarchy-migrate-notify.service
enable omarchy-crash-watch.service
enable omarchy-recover-internal-monitor.service

# Opt-in integrations: enabled by their install commands
# (omarchy-install-service-tailscale) or by omarchy-audio-tuning, both
# user-scope.
disable omarchy-tailscale-receive.service
disable omarchy-speaker-tuning.service

# Base ships the bazaar user unit (mkosi.images/base/mkosi.extra); bazaar is
# the snow/GNOME store companion and its binary is not on flurry, so
# default-enable would start-and-fail it every session.
disable bazaar.service

# Debian podman's user-scope API service fails at session start ("unexpected
# fd received from systemd: cannot listen on it", exit 125) and fumon then
# toasts the failure every login. podman.socket stays default-enabled, so
# the API still socket-activates on demand; the always-on service adds
# nothing. Likely not flurry-specific -- check snow.
disable podman.service
