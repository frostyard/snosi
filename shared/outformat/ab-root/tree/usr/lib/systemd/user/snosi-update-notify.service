# Native-A/B-named twin of bootc-update-notify.service (masked on native --
# see snosi-update-notify.path). Per-user desktop notification for a staged
# native A/B update, pending reboot. Ack-gated per staged version (the
# shared usr/libexec/bootc-update-notify script keys off /run/snosi/
# update-staged's version= field on native, digest= on bootc): notifies
# once per staged version, not per login or path trigger.
# Activated two ways, both static (no [Install]): its own
# graphical-session.target.wants/ link runs it once at session start
# (covers logging in while an update is already staged -- the condition
# below no-ops it otherwise), and snosi-update-notify.path triggers it when
# the semaphore is written mid-session. The path unit deliberately has no
# PathExists= (level-triggered conditions retrigger-loop on a file that
# persists until reboot -- see its header), so this wants link is
# load-bearing, not a convenience.
[Unit]
Description=Notify about a staged native A/B update pending reboot
After=graphical-session.target
ConditionPathExists=/run/snosi/update-staged
# One staging can trigger this several times in a burst (see the path
# unit). Repeat runs no-op via the per-version ack but still count as
# starts, so disable the default start-rate limit to avoid a spurious
# start-limit failure.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/libexec/bootc-update-notify
