#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Build guard: a preset that enables snosi-health.timer must be consistent with
# the image it is packed into (ADR-0029, modeled on updex-timer.finalize).
#
# The base tree ships /usr/bin/snosi-health, snosi-health.service and
# snosi-health.timer, and `06-snosi-health.preset` turns the timer on. A preset
# line with no unit behind it would leave every install without problem
# records, silently, and a preset line with no enablement-manifest entry would
# leave an EXISTING host without the timer: preset-reconcile only presets the
# units ADDED to /usr/share/snosi/enablement-manifest.txt (ADR-0002).
#
# This is a NON-chroot mkosi FinalizeScript: it runs on the host against
# $BUILDROOT, after shared/outformat/image/finalize/mkosi.finalize.chroot has
# written the manifest and stripped the /etc enablement links.
#
# It fails the build when any *.preset under usr/lib/systemd/system-preset or
# etc/systemd/system-preset enables snosi-health.timer AND
#   - usr/lib/systemd/system/snosi-health.timer,
#     usr/lib/systemd/system/snosi-health.service or usr/bin/snosi-health is
#     not a regular file, or
#   - the manifest is missing or lacks the exact line
#     "system timers.target.wants/snosi-health.timer".
#
# The guard fails closed: an unreadable preset directory, a find(1) error or a
# grep(1) read error fails the build instead of reporting the image clean.
set -euo pipefail

: "${BUILDROOT:?snosi-health-timer.finalize: \$BUILDROOT not set (must run as a FinalizeScript)}"

USR_PRESET_DIR="$BUILDROOT/usr/lib/systemd/system-preset"
ETC_PRESET_DIR="$BUILDROOT/etc/systemd/system-preset"
TIMER_UNIT="$BUILDROOT/usr/lib/systemd/system/snosi-health.timer"
SERVICE_UNIT="$BUILDROOT/usr/lib/systemd/system/snosi-health.service"
COLLECTOR="$BUILDROOT/usr/bin/snosi-health"
MANIFEST="$BUILDROOT/usr/share/snosi/enablement-manifest.txt"
MANIFEST_LINE="system timers.target.wants/snosi-health.timer"
PRESET_LINE='^[[:space:]]*enable[[:space:]]+snosi-health\.timer([[:space:]]|$)'

die() {
    echo "snosi-health-timer.finalize: $*" >&2
    exit 1
}

# --- 1. the base preset directory must exist and be readable ----------------
# base owns usr/lib/systemd/system-preset; a missing or unreadable directory
# means the preset set cannot be judged, so the build fails.
if [[ ! -d "$USR_PRESET_DIR" ]]; then
    die "$USR_PRESET_DIR is missing (preset policy cannot be checked)"
fi
if [[ ! -r "$USR_PRESET_DIR" ]]; then
    die "$USR_PRESET_DIR is unreadable (preset policy cannot be checked)"
fi

# --- 2. which presets enable the timer? -------------------------------------
list=$(mktemp)
trap 'rm -f "$list"' EXIT

preset_dirs=("$USR_PRESET_DIR")
[[ -d "$ETC_PRESET_DIR" ]] && preset_dirs+=("$ETC_PRESET_DIR")
if ! find "${preset_dirs[@]}" -maxdepth 1 -type f -name '*.preset' -print >"$list" 2>/dev/null; then
    die "cannot list the *.preset files under ${preset_dirs[*]}"
fi

enabled_by=""
status=0
while IFS= read -r preset; do
    if grep -qE "$PRESET_LINE" "$preset"; then
        enabled_by="$preset"
        break
    else
        status=$?
        # grep exits 1 for "no match" (clean) and 2 for a read error (fatal).
        if [[ $status -ne 1 ]]; then
            die "cannot read $preset (grep exit $status)"
        fi
    fi
done <"$list"

if [[ -z "$enabled_by" ]]; then
    echo "snosi-health-timer.finalize: no preset enables snosi-health.timer; nothing to check"
    exit 0
fi

echo "snosi-health-timer.finalize: $(basename "$enabled_by") enables snosi-health.timer"

# --- 3. both units and the collector must ship ------------------------------
for unit in "$TIMER_UNIT" "$SERVICE_UNIT" "$COLLECTOR"; do
    [[ -f "$unit" ]] || die "$enabled_by enables snosi-health.timer but ${unit#"$BUILDROOT"} is missing or not a regular file"
done

# --- 4. an existing host needs the manifest entry to get the timer ----------
[[ -f "$MANIFEST" ]] || die "$enabled_by enables snosi-health.timer but ${MANIFEST#"$BUILDROOT"} is missing (preset-reconcile would never enable it on an existing host)"

if grep -Fqx "$MANIFEST_LINE" "$MANIFEST"; then
    :
else
    status=$?
    if [[ $status -ne 1 ]]; then
        die "cannot read ${MANIFEST#"$BUILDROOT"} (grep exit $status)"
    fi
    die "${MANIFEST#"$BUILDROOT"} lacks the entry \"$MANIFEST_LINE\" (preset-reconcile would never enable snosi-health.timer on an existing host)"
fi

echo "snosi-health-timer.finalize: snosi-health.timer ships, is preset-enabled and is recorded in the enablement manifest"
