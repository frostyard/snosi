# Forky builds only: overrides mkosi.sandbox/etc/apt/sources.list.d/debian-backports.sources
# (trixie) through the later shared/suite/forky/sandbox tree (ADR-0037).
Types: deb deb-src
URIs: https://deb.debian.org/debian
Suites: forky-backports
Components: main contrib non-free non-free-firmware
Enabled: yes
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
