# Forky builds only: overrides mkosi.sandbox/etc/apt/sources.list.d/frostyard.sources
# (trixie) through the later shared/suite/forky/sandbox tree (ADR-0037).
# Build sandbox only; installed images ship no Frostyard APT source. `image`
# holds image-only builds (core ADR-0059).
Types: deb
URIs: https://repository.frostyard.org/debian/
Suites: forky
Components: main image
Architectures: all amd64
Enabled: yes
Signed-By: /etc/apt/keyrings/frostyard.gpg
