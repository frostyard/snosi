{
  "name": "snosi-native-installer-redirect",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run types:check && npm test",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types worker-configuration.d.ts --include-runtime false",
    "types:check": "wrangler types --include-runtime false --check"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@vitest/coverage-istanbul": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  }
}
